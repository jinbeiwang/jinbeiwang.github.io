---
import '../../styles/base.css';
import { getCollection } from 'astro:content';
import site from '../../data/site.json';
import projects from '../../data/projects.json';
import Entry from '../../components/Entry.astro';
import { fmtDate, noteHref, notePath, tagSlug } from '../../lib/notes';

export async function getStaticPaths() {
  const notes = (await getCollection('notes', ({ data }) => !data.draft)).map((e) => ({
    href: noteHref(e.id),
    path: notePath(e.id),
    title: e.data.title,
    summary: e.data.summary,
    date: fmtDate(e.data.date),
    category: e.data.category,
    tags: e.data.tags,
    lang: e.data.lang,
    source: `${site.sourceRepo}/blob/main/src/content/notes/${e.id}.md`,
    kind: 'note' as const,
  }));

  // External projects carry tags too, and the dashboard's chip bar already counts
  // them ("tag chips cover notes and external projects alike", index.astro). These
  // pages used to be built from the note collection alone, so every tag link on a
  // project row pointed at a URL that was never generated — /tags/ai-agents.html
  // among them.
  const siblings = projects.map((p) => ({
    href: p.url,
    path: `/${p.repo}/`,
    title: p.title,
    summary: p.summary,
    date: '',
    category: p.category,
    tags: p.tags,
    lang: p.lang,
    source: p.source,
    note: p.category,
    kind: 'project' as const,
  }));

  // The guide series is indexed under the same tags, so the tag pages it shares
  // with the note collection stay complete. One row per chapter that exists.
  const guideEntries = await getCollection('guide', ({ data }) => !data.draft);
  const guideIndex = guideEntries.find((e) => e.data.kind === 'index');
  const guideChapterEntries = guideEntries
    .filter((e) => e.data.kind === 'chapter')
    .sort((a, b) => a.data.order - b.data.order);
  const guideSiblings = [
    ...(guideIndex
      ? [
          {
            href: '/guide.html',
            path: '/guide/',
            title: guideIndex.data.title,
            summary: guideIndex.data.summary,
            date: '',
            category: 'Guide',
            tags: guideIndex.data.tags,
            lang: guideIndex.data.lang,
            source: `${site.sourceRepo}/blob/main/src/content/guide/${guideIndex.id}.md`,
            note: 'Guide',
            kind: 'project' as const,
          },
        ]
      : []),
    ...guideChapterEntries.map((e) => ({
      href: `/guide/${e.id}.html`,
      path: `/guide/${e.id}.html`,
      title: e.data.title,
      summary: e.data.summary,
      date: '',
      category: 'Guide',
      tags: e.data.tags,
      lang: e.data.lang,
      source: `${site.sourceRepo}/blob/main/src/content/guide/${e.id}.md`,
      note: 'Guide',
      kind: 'project' as const,
    })),
  ];

  const byTag = new Map<string, { label: string; list: any[] }>();
  for (const item of [...notes, ...siblings, ...guideSiblings]) {
    for (const t of item.tags || []) {
      const slug = tagSlug(t);
      if (!slug) continue;
      if (!byTag.has(slug)) byTag.set(slug, { label: t, list: [] });
      byTag.get(slug)!.list.push(item);
    }
  }
  return [...byTag.entries()].map(([tag, v]) => ({
    params: { tag },
    props: { label: v.label, list: v.list },
  }));
}

const { label, list } = Astro.props;
// Notes are newest-first; project rows carry no date of their own and follow them.
const items = [...list].sort((a: any, b: any) =>
  String(b.date || '').localeCompare(String(a.date || ''))
);
const noteCount = items.filter((i: any) => i.kind === 'note').length;
const otherCount = items.length - noteCount;
---


<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <title>{label} — {site.title}</title>
  <meta name="description" content={`Notes and projects tagged ${label}.`} />
</head>
<body>
  <div class="wrap">
    <header>
      <div class="kicker">Tag</div>
      <h1>{label}</h1>
      <p class="deck">Tagged in {noteCount} {noteCount === 1 ? 'note' : 'notes'} and {otherCount} other {otherCount === 1 ? 'page' : 'pages'}.</p>
      <hr class="rule" />
    </header>

    <main>
      <section>
        <div class="sec-head">
          <h2>{label}</h2>
          <span class="count">{items.length}</span>
          <span class="hint">Notes first, then other pages</span>
        </div>
        <div class="body">
          {items.map((n: any) => <Entry {...n} />)}
        </div>
      </section>
    </main>

    <footer>
      <a href="/">&#8592; All notes</a>
      <span class="sp">{site.author} · {site.location}</span>
    </footer>
  </div>
</body>
</html>
